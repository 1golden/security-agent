# LLM backend (used by LLMPolicy and the generator)
SA_LLM_BACKEND=dummy           # dummy | openai | ollama
SA_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Pipeline
SA_MAX_RETRIES=2
SA_LOG_DIR=runs/
SA_COVERAGE_THRESHOLD=0.5

# Memory backend
SA_MEMORY_BACKEND=inmem        # inmem | amem
SA_AMEM_ROOT=/mnt/d/Project/WORK/all-in-rag/A-mem-sys
SA_CHROMA_PATH=./chroma_db

# Retrieval backend
SA_RETRIEVER_BACKEND=dummy     # dummy | handmade_rag
SA_HANDMADE_RAG_ROOT=/mnt/d/Project/WORK/all-in-rag/code/handmade_rag
